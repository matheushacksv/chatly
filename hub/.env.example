# Django
SECRET_KEY=change-me-generate-with-python-secrets
DEBUG=False
ALLOWED_HOSTS=api.seudominio.com

# Frontend
FRONTEND_URL=https://app.seudominio.com

# CORS
CORS_ALLOWED_ORIGINS=https://app.seudominio.com
CSRF_TRUSTED_ORIGINS=https://api.seudominio.com,https://app.seudominio.com

# PostgreSQL
POSTGRES_DB=chatlyai
POSTGRES_USER=chatlyai_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible storage)
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=chatlyai

# Encryption (required — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# Public base URL (used for webhook URLs shown in UI)
BASE_URL=https://api.seudominio.com

# AI
GROQ_API_KEY=

# WhatsApp (EvoGO)
EVOGO_BASE_URL=
EVOGO_GLOBAL_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ChatlyAi <noreply@seudominio.com>

# Pipedrive (opcional)
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
